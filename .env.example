# CatalogLink — required environment variables
# Copy to .env and fill in the blanks. Generate secrets with: openssl rand -base64 32

# Database & queue
DATABASE_URL=postgresql://cataloglink:cataloglink@localhost:5432/cataloglink
REDIS_URL=redis://localhost:6379

# Public base URL of the web app (catalog links, QR codes, OAuth redirect)
APP_URL=http://localhost:3000

# Secrets
SESSION_SECRET=            # signs session JWT cookies (32+ random chars)
ENCRYPTION_KEY=            # 32-byte base64 key, encrypts Google OAuth tokens (AES-256-GCM)
INTERNAL_API_SECRET=       # authenticates worker -> web cache revalidation calls

# Google (Sheets + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-sa.json

# OTP login by SMS is switched OFF for now (packages/core/src/features.ts), so these are
# ignored and not needed. When it's turned back on: console (prints OTP to the log, dev) | msg91
OTP_PROVIDER=off
MSG91_AUTH_KEY=            # required when OTP_PROVIDER=msg91
MSG91_OTP_TEMPLATE_ID=     # required when OTP_PROVIDER=msg91

# First Super Admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
